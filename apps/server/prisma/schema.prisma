generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  pro
}

enum Status {
  draft
  published
  closed
}

enum SubscriptionStatus {
  active
  canceled
  past_due
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application tables
model User {
  id               String   @id @default(cuid())
  googleId         String?  @unique
  email            String   @unique
  name             String?
  avatarUrl        String?
  stripeCustomerId String?
  plan             Plan     @default(free)
  aiCreditsUsed    Int      @default(0)
  aiCreditsResetAt DateTime @default(now())
  passwordHash     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  forms                Form[]
  templates            Template[]
  subscriptions        Subscription[]
  marketplaceUpvotes   MarketplaceUpvote[]
  collaborator         Collaborator[]         @relation("UserCollaborators")
  Response             Response[]
  MarketplaceListing   MarketplaceListing[]
  AnalysisConversation AnalysisConversation[]
  Webhook              Webhook[]
}

model Form {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  description String?
  schema      Json
  isPublished Boolean  @default(false)
  isAnonymous Boolean  @default(false)
  publicSlug  String?  @unique
  status      Status   @default(draft)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  responses             Response[]
  collaborators         Collaborator[]         @relation("FormCollaborators")
  webhooks              Webhook[]
  analysisConversations AnalysisConversation[]
  Template              Template[]
  EmailNotification     EmailNotification[]
}

model Response {
  id           String   @id @default(cuid())
  formId       String
  respondentId String?
  answers      Json
  metadata     Json?
  submittedAt  DateTime @default(now())

  form       Form  @relation(fields: [formId], references: [id], onDelete: Cascade)
  respondent User? @relation(fields: [respondentId], references: [id], onDelete: SetNull)
}

model Template {
  id           String   @id @default(cuid())
  ownerId      String
  title        String
  description  String?
  schema       Json
  isPublic     Boolean  @default(false)
  sourceFormId String?
  createdAt    DateTime @default(now())

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceForm          Form?                @relation(fields: [sourceFormId], references: [id], onDelete: SetNull)
  marketplaceListings MarketplaceListing[]
}

model MarketplaceListing {
  id          String   @id @default(cuid())
  templateId  String
  publisherId String
  title       String
  description String?
  category    String?
  tags        String[]
  upvoteCount Int      @default(0)
  copyCount   Int      @default(0)
  createdAt   DateTime @default(now())

  template  Template            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  publisher User                @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  upvotes   MarketplaceUpvote[]
}

model MarketplaceUpvote {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model AnalysisConversation {
  id        String   @id @default(cuid())
  formId    String
  ownerId   String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form  Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String
  stripeSubscriptionId String?             @unique
  stripePriceId        String?
  status               SubscriptionStatus?
  currentPeriodEnd     DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String   @id @default(cuid())
  ownerId   String
  url       String
  events    String[]
  secret    String?
  formId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  form  Form? @relation(fields: [formId], references: [id], onDelete: SetNull)
}

model Collaborator {
  id        String   @id @default(cuid())
  formId    String
  userId    String
  role      String   @default("editor")
  createdAt DateTime @default(now())

  form Form @relation("FormCollaborators", fields: [formId], references: [id], onDelete: Cascade)
  user User @relation("UserCollaborators", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
}

model EmailNotification {
  id             String   @id @default(cuid())
  formId         String
  type           String
  recipientEmail String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
}
